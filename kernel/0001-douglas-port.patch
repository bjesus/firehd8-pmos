+				compatible = "ti,tmp103";
+				reg = <0x70>;
+				status = "disabled";
+			};
+
+			tmp103_1: tmp103@71 {
+				compatible = "ti,tmp103";
+				reg = <0x71>;
+				status = "disabled";
+			};
+
+			tmp103_2: tmp103@72 {
+				compatible = "ti,tmp103";
+				reg = <0x72>;
+				status = "disabled";
+			};
+
+			charger: bq24296@6b {
+				compatible = "ti,bq24297";
+				reg = <0x6b>;
+				pinctrl-names = "default";
+				pinctrl-0 = <&bq24297_pins>;
+				interrupt-parent = <&pio>;
+				interrupts = <1 IRQ_TYPE_EDGE_FALLING>;
+				ti,system-minimum-microvolt = <3500000>;
+				disable-reset;
