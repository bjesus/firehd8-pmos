+			compatible = "mediatek,mt8173-i2c";
+			reg = <0x0 0x11009000 0x0 0x70>,
+			      <0x0 0x11000280 0x0 0x80>;
+			interrupts = <GIC_SPI 86 IRQ_TYPE_LEVEL_LOW>;
+			clock-div = <10>;
+			clocks = <&infracfg CLK_INFRA_I2C2>, <&infracfg CLK_INFRA_AP_DMA>;
+			clock-names = "main", "dma";
+			clock-frequency = <400000>;
+			pinctrl-names = "default";
+			pinctrl-0 = <&i2c2_pins_a>;
+			#address-cells = <1>;
+			#size-cells = <0>;
+			status = "okay";
+
+			/*
+			 * PCB temperature sensors (vendor DTB: tmp103-sensor@70
+			 * /71/72). Kept disabled: tested on this board, nothing
+			 * ACKs at 0x70/0x71/0x72 on this bus while 0x18 (bma253)
+			 * and 0x6b (charger) do, so the sensors are either
+			 * unpowered or not fitted. That NAK is what the
+			 * "tmp103 2-0070: error writing config register" probe
+			 * failure actually is. Find the rail that powers them
+			 * (the MT6323 LDO list is the place to look) before
+			 * enabling these - CONFIG_SENSORS_TMP103 is already =y
+			 * and the driver matches "ti,tmp103" correctly.
+			 */
