From 62352fed7b19d35c2459043b256889b5c1e3adf3 Mon Sep 17 00:00:00 2001
From: Yo'av Moshe <github@yoavmoshe.com>
Date: Thu, 26 Nov 2026 15:20:50 +0100
Subject: [PATCH 12/12] usb: musb: mediatek: register the role switch on the
 controller device

postmarketOS usb-signaller finds the UDC as <role-switch>/device/udc/; on
the glue device that path does not exist (the UDC is a child), so it
reported "URS Device has no UDC assigned" and Phosh showed an unknown USB
mode.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 drivers/usb/musb/mediatek.c | 7 ++++++-
 1 file changed, 6 insertions(+), 1 deletion(-)

diff --git a/drivers/usb/musb/mediatek.c b/drivers/usb/musb/mediatek.c
index f60ce8078..12588f961 100644
--- a/drivers/usb/musb/mediatek.c
+++ b/drivers/usb/musb/mediatek.c
@@ -767,7 +767,12 @@ static int mtk_otg_switch_init(struct mtk_glue *glue)
 	role_sx_desc.allow_userspace_control = true;
 	role_sx_desc.fwnode = dev_fwnode(glue->dev);
 	role_sx_desc.driver_data = glue;
-	glue->role_sw = usb_role_switch_register(glue->dev, &role_sx_desc);
+	/*
+	 * douglas: register the switch on the musb controller device (the one
+	 * that owns the UDC) rather than on the glue. Userspace (postmarketOS
+	 * usb-signaller) resolves the gadget as <role-switch>/device/udc/.
+	 */
+	glue->role_sw = usb_role_switch_register(&glue->musb_pdev->dev, &role_sx_desc);
 
 	return PTR_ERR_OR_ZERO(glue->role_sw);
 }
-- 
2.56.1

