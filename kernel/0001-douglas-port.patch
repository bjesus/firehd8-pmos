diff --git a/arch/arm64/kernel/dtb_builtin.S b/arch/arm64/kernel/dtb_builtin.S
new file mode 100644
index 000000000..3054b0b2b
--- /dev/null
+++ b/arch/arm64/kernel/dtb_builtin.S
@@ -0,0 +1,14 @@
+/*
+ * Built-in device tree blob for the Amazon Fire HD 8 (douglas).
+ * The LK bootloader always passes its own 3.18-era DTB which is unusable
+ * by mainline; setup_arch() unconditionally points __fdt_pointer at this
+ * blob instead (see arch/arm64/kernel/setup.c).
+ */
+	.section .rodata
+	.balign 4096
+	.global dtb_builtin_begin
+dtb_builtin_begin:
+	.incbin DTB_PATH
+	.global dtb_builtin_end
+dtb_builtin_end:
+	.balign 8
diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index cdbbc95eb..0ef5089f5 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -86,6 +86,12 @@
 	 *  x28        create_idmap()                           callee preserved temp register
 	 */
 SYM_CODE_START(primary_entry)
+	/* douglas: raw physical marker '0' at 0x9850000c before MMU is on */
+	movz	x9, #0x000c
+	movk	x9, #0x9850, lsl #16
+	mov	w10, #0x30
+	strb	w10, [x9]
+	dsb	sy
 	bl	preserve_boot_args
 	bl	init_kernel_el			// w0=cpu_boot_mode
 	mov	x20, x0
@@ -106,6 +112,12 @@ SYM_CODE_START(primary_entry)
 	mov	x0, x25
 #endif
 	bl	__cpu_setup			// initialise processor
+	/* douglas: raw physical marker '1' at 0x9850000d before __primary_switch */
+	movz	x9, #0x000d
+	movk	x9, #0x9850, lsl #16
+	mov	w10, #0x31
+	strb	w10, [x9]
+	dsb	sy
 	b	__primary_switch
 SYM_CODE_END(primary_entry)
 
diff --git a/arch/arm64/kernel/psci.c b/arch/arm64/kernel/psci.c
index 29a8e444d..f55c4685f 100644
--- a/arch/arm64/kernel/psci.c
+++ b/arch/arm64/kernel/psci.c
@@ -9,6 +9,7 @@
 #define pr_fmt(fmt) "psci: " fmt
 
 #include <linux/init.h>
+#include <linux/io.h>
 #include <linux/of.h>
 #include <linux/smp.h>
 #include <linux/delay.h>
@@ -36,6 +37,69 @@ static int __init cpu_psci_cpu_prepare(unsigned int cpu)
 	return 0;
 }
 
+static void mt8163_spm_cpu_power_on(unsigned int cpu)
+{
+	static void __iomem *spm;
+	static const u32 pwr_con_offs[4] = { 0x0200, 0x0218, 0x021c, 0x0220 };
+	static const u32 l1_pdn_offs[4]  = { 0x025c, 0x0264, 0x026c, 0x0274 };
+	static const u32 sta_bits[4]     = { BIT(9), BIT(10), BIT(11), BIT(12) };
+	u32 pwr_con, l1_pdn, sta;
+	int to;
+
+	if (cpu == 0 || cpu >= 4)
+		return;
+
+	if (!spm) {
+		spm = ioremap(0x10006000, 0x1000);
+		if (!spm) {
+			pr_err("mt8163-smp: failed to ioremap SPM\n");
+			return;
+		}
+	}
+
+	pwr_con = pwr_con_offs[cpu];
+	l1_pdn = l1_pdn_offs[cpu];
+	sta = sta_bits[cpu];
+
+	/* Enable SPM register control */
+	writel((0x0b16U << 16) | BIT(0), spm + 0x0000);
+
+	writel(readl(spm + pwr_con) | BIT(2), spm + pwr_con);	/* PWR_ON */
+	udelay(1);
+	writel(readl(spm + pwr_con) | BIT(3), spm + pwr_con);	/* PWR_ON_2ND */
+
+	for (to = 10000; to > 0; to--) {
+		if ((readl(spm + 0x060c) & sta) && (readl(spm + 0x0610) & sta))
+			break;
+		udelay(1);
+	}
+	if (!to) {
+		pr_err("mt8163-smp: CPU%u PWR_STATUS timeout\n", cpu);
+		return;
+	}
+
+	writel(readl(spm + pwr_con) & ~BIT(1), spm + pwr_con);	/* ~PWR_ISO */
+	writel(readl(spm + l1_pdn) & ~BIT(0), spm + l1_pdn);	/* ~L1_PDN */
+
+	for (to = 10000; to > 0; to--) {
+		if ((readl(spm + l1_pdn) & BIT(8)) == 0)	/* L1_PDN_ACK */
+			break;
+		udelay(1);
+	}
+	if (!to) {
+		pr_err("mt8163-smp: CPU%u L1_PDN_ACK timeout\n", cpu);
+		return;
+	}
+
+	udelay(1);
+	writel(readl(spm + pwr_con) | BIT(6), spm + pwr_con);	/* SRAM_ISOINT_B */
+	writel(readl(spm + pwr_con) & ~BIT(5), spm + pwr_con);	/* ~SRAM_CKISO */
+	writel(readl(spm + pwr_con) & ~BIT(4), spm + pwr_con);	/* ~PWR_CLK_DIS */
+	writel(readl(spm + pwr_con) | BIT(0), spm + pwr_con);	/* PWR_RST_B */
+
+	pr_info("mt8163-smp: powered on CPU%u via SPM\n", cpu);
+}
+
 static int cpu_psci_cpu_boot(unsigned int cpu)
 {
 	phys_addr_t pa_secondary_entry = __pa_symbol(secondary_entry);
@@ -43,6 +107,9 @@ static int cpu_psci_cpu_boot(unsigned int cpu)
 	if (err)
 		pr_err("failed to boot CPU%d (%d)\n", cpu, err);
 
+	if (!err && of_machine_is_compatible("amazon,douglas"))
+		mt8163_spm_cpu_power_on(cpu);
+
 	return err;
 }
 
diff --git a/arch/arm64/kernel/setup.c b/arch/arm64/kernel/setup.c
