From 79425471636fd5e5c9151408ed3f02df8c330466 Mon Sep 17 00:00:00 2001
From: Yo'av Moshe <github@yoavmoshe.com>
Date: Sun, 22 Nov 2026 12:47:56 +0100
Subject: [PATCH 05/12] arm64: dts: mt8163-douglas: enable the PMIC long-press
 hardware reset

An 8 s Power hold resets the board through the MT6323 regardless of the
kernel or userspace state. Without it a session that cannot reach elogind
leaves the user with no way to power the tablet off.

Co-Authored-By: Claude Fable 5.1 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/mediatek/mt8163-douglas.dts | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/mediatek/mt8163-douglas.dts b/arch/arm64/boot/dts/mediatek/mt8163-douglas.dts
index 4cd041f55..08d6b0184 100644
--- a/arch/arm64/boot/dts/mediatek/mt8163-douglas.dts
+++ b/arch/arm64/boot/dts/mediatek/mt8163-douglas.dts
@@ -423,6 +423,11 @@ rtc {
 				 */
 				keys {
 					compatible = "mediatek,mt6323-keys";
+					/* PMIC hardware reset on an ~8 s Power hold, independent of
+					 * the kernel and userspace: the only way out when the
+					 * session cannot reach elogind (2026-11-22). */
+					mediatek,long-press-mode = <1>;
+					power-off-time-sec = <0>;
 
 					power {
 						linux,keycodes = <KEY_POWER>;
-- 
