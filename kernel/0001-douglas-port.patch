 {
 	setup_initial_init_mm(_stext, _etext, _edata, _end);
@@ -301,9 +387,31 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 	arm64_use_ng_mappings = kaslr_requires_kpti();
 
 	early_fixmap_init();
