# Reference: <https://postmarketos.org/deviceinfo>
# Please use double quotes only. You can source this file in shell
# scripts.

deviceinfo_format_version="0"
deviceinfo_name="Amazon Fire HD 8 (2017)"
deviceinfo_manufacturer="Amazon"
deviceinfo_codename="amazon-douglas"
deviceinfo_year="2017"
deviceinfo_arch="aarch64"

# Device related
deviceinfo_chassis="tablet"
deviceinfo_drm="true"
deviceinfo_keyboard="false"
deviceinfo_external_storage="false"
deviceinfo_screen_width="800"
deviceinfo_screen_height="1280"

# The kernel boots from its built-in device tree and only takes the ramdisk
# location from the tree LK hands over. That tree is the vendor DTB appended
# here (LK patches /chosen into it); see linux-amazon-douglas.
# The boot partition is 16 MiB: keep the boot.img initramfs minimal and load
# initramfs-extra from the pmOS_boot filesystem (stage 1 finds it with losetup -P).
deviceinfo_create_initfs_extra="true"
deviceinfo_dtb="mediatek/mt8163-douglas-lk"
deviceinfo_append_dtb="true"

# Bootloader related: Amazon LK (unlocked with amonet), boot.img on mmcblk0p5,
# rootfs on mmcblk0p16 (userdata). Flashed from TWRP with dd, see the README.
# "fastboot" is only the name of the Android-style layout for boot-deploy; the actual
# write on kernel updates is a dd by boot-deploy to the partition labelled boot_x (p5),
# so `apk upgrade` is the whole update. TWRP is still how the images are installed.
deviceinfo_flash_method="fastboot"
deviceinfo_flash_kernel_on_update="true"
deviceinfo_flash_fastboot_partition_kernel="boot_x"
deviceinfo_generate_bootimg="true"
deviceinfo_kernel_cmdline="bootopt=64S3,32N2,64N2"
deviceinfo_flash_pagesize="2048"
deviceinfo_flash_offset_base="0x40000000"
deviceinfo_flash_offset_kernel="0x00080000"
deviceinfo_flash_offset_ramdisk="0x03480000"
deviceinfo_flash_offset_second="0x00f00000"
deviceinfo_flash_offset_tags="0x08000000"
