# Maintainer: Yoav Moshe <bjesus@users.noreply.github.com>
pkgname=firmware-amazon-douglas
pkgver=1
pkgrel=0
pkgdesc="Firmware for the Amazon Fire HD 8 (2017): MT6625L Wi-Fi/Bluetooth, Goodix touch, MD32"
url="https://github.com/bjesus/firehd8-pmos"
arch="noarch"
license="proprietary"
options="!check !strip !archcheck !tracedeps"
# Taken from the tablet's own Amazon firmware; the same files are shipped by
# https://github.com/aslater3/LibreEcho-mt8163-connectivity and the Amazon GPL
# kernel sources. The vendor connectivity stack looks in both directories.
source="
	WMT_SOC.cfg
	ROMv2_lm_patch_1_0_hdr.bin
	ROMv2_lm_patch_1_1_hdr.bin
	WIFI_RAM_CODE_8163
	gt9xx_fw.bin
	md32_d.bin
	md32_p.bin
"

package() {
	for f in $source; do
		install -Dm644 "$srcdir/$f" "$pkgdir/lib/firmware/$f"
		install -Dm644 "$srcdir/$f" "$pkgdir/etc/firmware/$f"
	done
}

