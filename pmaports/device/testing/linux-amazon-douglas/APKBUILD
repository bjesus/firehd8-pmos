fc7d5745c195d84f74541e6b991e3841faf7d0838611d6662d696f54cb26c287f152df11ad8d02aac753e6103616468e7ccdaf8a0f4106faa6bcde726b4fb616  config-amazon-douglas.aarch64
69f11f157bb17f32fa649ed1a0aa0fdf30027147408335d33e4cdde898fd12825445d9d2f67b4df6b52fec2e744ce5979393f9b95de2732d8974bbe22e9c4389  mt8163-douglas-lk.dtb
"
