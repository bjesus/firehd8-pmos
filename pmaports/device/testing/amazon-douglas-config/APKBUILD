# Maintainer: Yoav Moshe <bjesus@users.noreply.github.com>
pkgname=amazon-douglas-config
pkgdesc="Amazon Fire HD 8 (2017) configuration: Wi-Fi/BT bring-up, sleep hook, sensors, defaults"
pkgver=1
pkgrel=1
url="https://github.com/bjesus/firehd8-pmos"
license="MIT"
arch="noarch"
options="!check"
depends="
	bluez
	iio-sensor-proxy
	iw
	networkmanager-wifi
	python3
"
source="
	wmt-launcher.py
	douglas-wifi-on.sh
	douglas-wmt.service
	douglas-wifi.service
	douglas-sleep.sh
	99-douglas-accel.rules
	90-douglas-usb-role.rules
	20-douglas-nm.conf
	douglas-tmpfiles.conf
	douglas-modules.conf
	phoc.ini
	bjesus-pmos.rsa.pub
	amazon-douglas.list
"

package() {
	# MT6625L connectivity: userspace side of the vendor WMT stack (patch
	# download handshake on /dev/stpwmt), then power the Wi-Fi function on.
	install -Dm755 "$srcdir"/wmt-launcher.py "$pkgdir"/usr/libexec/douglas/wmt-launcher.py
	install -Dm755 "$srcdir"/douglas-wifi-on.sh "$pkgdir"/usr/libexec/douglas/douglas-wifi-on.sh
	install -Dm644 "$srcdir"/douglas-wmt.service "$pkgdir"/usr/lib/systemd/system/douglas-wmt.service
	install -Dm644 "$srcdir"/douglas-wifi.service "$pkgdir"/usr/lib/systemd/system/douglas-wifi.service
	mkdir -p "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants
	ln -s ../douglas-wmt.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/douglas-wmt.service
	ln -s ../douglas-wifi.service "$pkgdir"/usr/lib/systemd/system/multi-user.target.wants/douglas-wifi.service

	# The consys chip does not survive s2idle: power it off around sleep;
	# re-pull the USB gadget after resume.
	install -Dm755 "$srcdir"/douglas-sleep.sh "$pkgdir"/usr/lib/systemd/system-sleep/douglas

	# BMA253 is mounted with Y inverted
	install -Dm644 "$srcdir"/99-douglas-accel.rules "$pkgdir"/usr/lib/udev/rules.d/99-douglas-accel.rules
	install -Dm644 "$srcdir"/90-douglas-usb-role.rules "$pkgdir"/usr/lib/udev/rules.d/90-douglas-usb-role.rules
	# the Wi-Fi driver cannot change its MAC; ACD confuses it
	install -Dm644 "$srcdir"/20-douglas-nm.conf "$pkgdir"/usr/lib/NetworkManager/conf.d/20-douglas.conf
	# schedutil governor, 1.5 A charging (kernel defaults are conservative on purpose)
	install -Dm644 "$srcdir"/douglas-tmpfiles.conf "$pkgdir"/usr/lib/tmpfiles.d/douglas.conf
	# board drivers that are not device-tree bound
	install -Dm644 "$srcdir"/douglas-modules.conf "$pkgdir"/usr/lib/modules-load.d/douglas.conf
	install -Dm644 "$srcdir"/phoc.ini "$pkgdir"/etc/phosh/phoc.ini

	# Trust and enable the port's package repository (kernel and driver updates)
	install -Dm644 "$srcdir"/bjesus-pmos.rsa.pub "$pkgdir"/etc/apk/keys/bjesus-pmos.rsa.pub
	install -Dm644 "$srcdir"/amazon-douglas.list "$pkgdir"/etc/apk/repositories.d/amazon-douglas.list
}

