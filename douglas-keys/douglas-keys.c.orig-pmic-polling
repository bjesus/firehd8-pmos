#include <linux/module.h>
#include <linux/kernel.h>
#include <linux/init.h>
#include <linux/input.h>
#include <linux/io.h>
#include <linux/workqueue.h>
#include <linux/platform_device.h>
#include <linux/regmap.h>
#include <linux/mfd/mt6397/core.h>
#include <linux/mfd/mt6323/registers.h>

#define KPD_BASE_PHYS	0x10010000
#define KPD_MEM1	0x0004

struct douglas_keys {
	struct input_dev *input;
	void __iomem *kpd_base;
	struct regmap *pmic_regmap;
	struct delayed_work poll_work;
	bool last_pwr;
	bool last_voldn;
	bool last_volup;
};

static struct douglas_keys *g_dkeys;

static void douglas_keys_poll(struct work_struct *work)
{
	struct douglas_keys *dk = container_of(to_delayed_work(work),
					       struct douglas_keys, poll_work);
	u32 chrstatus = 0x6;
	u32 kpd_mem1 = 0xffff;
	bool pwr, voldn, volup;
	bool changed = false;

	if (dk->pmic_regmap)
		regmap_read(dk->pmic_regmap, MT6323_CHRSTATUS, &chrstatus);

	if (dk->kpd_base)
		kpd_mem1 = readl(dk->kpd_base + KPD_MEM1);

	/* Active low (0 = pressed, 1 = released) */
	pwr   = !(chrstatus & 0x2);
	voldn = !(chrstatus & 0x4);
	volup = !(kpd_mem1 & 0x1);

	if (pwr != dk->last_pwr) {
		input_report_key(dk->input, KEY_POWER, pwr);
		dk->last_pwr = pwr;
		changed = true;
	}
	if (voldn != dk->last_voldn) {
		input_report_key(dk->input, KEY_VOLUMEDOWN, voldn);
		dk->last_voldn = voldn;
		changed = true;
	}
	if (volup != dk->last_volup) {
		input_report_key(dk->input, KEY_VOLUMEUP, volup);
		dk->last_volup = volup;
		changed = true;
	}
	if (changed)
		input_sync(dk->input);

	schedule_delayed_work(&dk->poll_work, msecs_to_jiffies(25));
}

static int __init douglas_keys_init(void)
{
	struct device *pmic_dev;
	struct mt6397_chip *chip;
	struct douglas_keys *dk;
	int ret;

	dk = kzalloc(sizeof(*dk), GFP_KERNEL);
	if (!dk)
		return -ENOMEM;

	dk->kpd_base = ioremap(KPD_BASE_PHYS, 0x100);
	if (!dk->kpd_base) {
		kfree(dk);
		return -ENOMEM;
	}

	pmic_dev = bus_find_device_by_name(&platform_bus_type, NULL,
					   "1000d000.pwrap:mt6323");
	if (pmic_dev) {
		chip = dev_get_drvdata(pmic_dev);
		if (chip && chip->regmap)
			dk->pmic_regmap = chip->regmap;
		else
			dk->pmic_regmap = dev_get_regmap(pmic_dev, NULL);
		put_device(pmic_dev);
	}

	if (!dk->pmic_regmap)
		pr_warn("douglas-keys: PMIC regmap not found, only KPD Volume Up available\n");

	dk->input = input_allocate_device();
	if (!dk->input) {
		iounmap(dk->kpd_base);
		kfree(dk);
		return -ENOMEM;
	}

	dk->input->name = "Douglas Power & Volume Keys";
	dk->input->phys = "douglas-keys/input0";
	dk->input->id.bustype = BUS_HOST;
	dk->input->id.vendor = 0x1949;
	dk->input->id.product = 0x0001;
	dk->input->id.version = 0x0100;

	__set_bit(EV_KEY, dk->input->evbit);
	input_set_capability(dk->input, EV_KEY, KEY_POWER);
	input_set_capability(dk->input, EV_KEY, KEY_VOLUMEUP);
	input_set_capability(dk->input, EV_KEY, KEY_VOLUMEDOWN);

	ret = input_register_device(dk->input);
	if (ret) {
		input_free_device(dk->input);
		iounmap(dk->kpd_base);
		kfree(dk);
		return ret;
	}

	g_dkeys = dk;
	INIT_DELAYED_WORK(&dk->poll_work, douglas_keys_poll);
	schedule_delayed_work(&dk->poll_work, msecs_to_jiffies(25));

	pr_info("douglas-keys: registered Power, Volume Up, Volume Down (pmic_regmap=%p)\n",
		dk->pmic_regmap);
	return 0;
}

static void __exit douglas_keys_exit(void)
{
	if (!g_dkeys)
		return;
	cancel_delayed_work_sync(&g_dkeys->poll_work);
	input_unregister_device(g_dkeys->input);
	iounmap(g_dkeys->kpd_base);
	kfree(g_dkeys);
	g_dkeys = NULL;
}

module_init(douglas_keys_init);
module_exit(douglas_keys_exit);
MODULE_LICENSE("GPL");
MODULE_DESCRIPTION("Amazon Fire HD 8 (douglas) Power & Volume Keys driver");
