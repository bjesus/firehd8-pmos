#!/bin/sh
# douglas: keep the USB-ethernet debug link alive when a host is attached.
# If the gadget is configured (host present) but the relay (10.42.0.1) stops
# answering, re-pull the gadget so the host re-enumerates. Never reboots.
UDC=/sys/class/udc/musb-hdrc.2.auto
fails=0
while :; do
  sleep 20
  [ "$(cat $UDC/state 2>/dev/null)" = "configured" ] || { fails=0; continue; }
  if ping -c1 -W3 10.42.0.1 >/dev/null 2>&1; then fails=0; continue; fi
  fails=$((fails+1))
  if [ $fails -ge 3 ]; then
    echo "usb-link-guard: host attached but relay silent, re-pulling gadget" > /dev/kmsg
    echo disconnect > $UDC/soft_connect 2>/dev/null; sleep 2; echo connect > $UDC/soft_connect 2>/dev/null
    sleep 3; ip addr add 10.42.0.2/24 dev usb0 2>/dev/null; ip link set usb0 up 2>/dev/null
    fails=0; sleep 60
  fi
done
