#!/bin/sh
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
mount -t proc none /proc 2>/dev/null
mount -t sysfs none /sys 2>/dev/null
mount -t devtmpfs none /dev 2>/dev/null
mkdir -p /dev/pts /dev/shm /run /tmp
mount -t devpts devpts /dev/pts 2>/dev/null
mount -t tmpfs tmpfs /dev/shm 2>/dev/null
mount -t tmpfs tmpfs /run 2>/dev/null
mount -t tmpfs tmpfs /tmp 2>/dev/null
chmod 1777 /dev/shm /tmp

exec >/dev/kmsg 2>&1
echo "=== ALPINE LINUX 3.21 ON FIRE HD 8 (DOUGLAS) MAINLINE 6.1 ==="
uname -a
hostname -F /etc/hostname

# Bring up loopback and USB Ethernet (10.42.0.2/24 via 10.42.0.1)
ip link set lo up
i=0
while [ $i -lt 10 ]; do
  [ -d /sys/class/net/usb0 ] && break
  usleep 500000
  i=$((i + 1))
done
if [ -d /sys/class/net/usb0 ]; then
  ip addr add 10.42.0.2/24 dev usb0 2>/dev/null || true
  ip link set usb0 up
  ip route add default via 10.42.0.1 dev usb0 2>/dev/null || true
  ip addr show usb0
fi

# Re-trigger ECM link notifications after the host has enumerated (~16s):
# the gadget signals carrier at t~1.4s, before the host attaches, and the
# notification is then missed -> host shows NO-CARRIER. Flap usb0 a few
# times early so at least one notification lands after host enumeration.
(
  for d in 8 12 15 20 30 45; do
    sleep $d
    [ -d /sys/class/net/usb0 ] || continue
    ip link set usb0 down 2>/dev/null
    usleep 200000
    ip link set usb0 up 2>/dev/null
    ip addr add 10.42.0.2/24 dev usb0 2>/dev/null || true
    echo "USB0_CARRIER_RETRIGGER at $d"
  done
) &

# Start Dropbear SSH server
/usr/sbin/dropbear -R -E -p 22
echo "DROPBEAR_SSH_STARTED_ON_10.42.0.2:22"

# Auto-start MT8163 ConSys Wi-Fi in background
(
  rm -f /tmp/wmt.log
  /usr/local/sbin/wmt-launcher.py > /tmp/wmt.log 2>&1 &
  r=0
  while [ $r -lt 60 ]; do
    grep -q "WMT launcher ready" /tmp/wmt.log 2>/dev/null && break
    usleep 500000
    r=$((r + 1))
  done
  sleep 1
  for attempt in 1 2; do
    [ -c /dev/wmtWifi ] && echo 1 > /dev/wmtWifi
    w=0
    while [ $w -lt 20 ]; do
      [ -d /sys/class/net/wlan0 ] && break
      usleep 500000
      w=$((w + 1))
    done
    [ -d /sys/class/net/wlan0 ] && break
    sleep 2
  done
  if [ -d /sys/class/net/wlan0 ]; then
    ip link set wlan0 up
    echo "WLAN0_AUTOSTARTED"
  fi
) &

# Auto-start Phosh Wayland shell
( /usr/local/sbin/start-phosh ) &

# Safety dead-man switch
if [ ! -f /etc/douglas-no-deadman ]; then
  (
    sleep 90
    if [ ! -f /tmp/stay-in-linux ] && [ ! -f /etc/douglas-no-deadman ]; then
      echo "DEADMAN_SWITCH_TRIGGERED: returning to TWRP"
      /usr/local/sbin/reboot-to-twrp
    fi
  ) &
fi

while true; do
  sleep 3600
done
